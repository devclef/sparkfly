# --- required (unless DRY_RUN=true) ---------------------------------------
# Shown in Firefly when you create the webhook (Automation → Webhooks)
FIREFLY_WEBHOOK_SECRET=replace-me
# Base URL of your SparkyFitness instance
SPARKY_URL=http://sparkyfitness-server:3010
# Write-enabled API key (Settings → API keys in SparkyFitness)
SPARKY_API_KEY=replace-me

# --- optional --------------------------------------------------------------
# Enables auto-registering the webhook + backfill + "test with recent tx"
# FIREFLY_URL=https://firefly.example.com
# FIREFLY_PAT=
# IANA time zone used for meal_type auto and entry_date/entry_time
# TZ=Europe/Berlin
# Process rules but never write to SparkyFitness
# DRY_RUN=true
# Basic-auth password for the status page (leave unset to leave it open
# and protect it with your reverse proxy)
# ADMIN_PASSWORD=
# HOST=0.0.0.0
# PORT=8080
# SPARKFLY_DATA_DIR=./data
# RULES_FILE=./config/rules.yaml
# SPARKFLY_WEBHOOK_PATH=/hooks/firefly
# LOG_LEVEL=info
# SPARKFLY_MAX_ATTEMPTS=10
# SPARKFLY_RETRY_BASE_MS=5000
# SPARKFLY_RETRY_MAX_MS=600000
# FIREFLY_SIGNATURE_TTL=300
